{
  "name": "missedlead-os",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:api\" \"pnpm dev:mobile\"",
    "dev:stable": "pnpm build && concurrently -k \"pnpm dev:api\" \"vite build --watch\" \"vite preview --host 127.0.0.1 --port 5194 --strictPort\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "start:api": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint --ignore-pattern \"supabase/.temp/**\"",
    "test": "vitest run --exclude server/app.integration.test.ts --exclude server/pilot.integration.test.ts",
    "test:integration": "vitest run server/app.integration.test.ts",
    "test:pilot-integration": "vitest run server/pilot.integration.test.ts",
    "doctor:mobile": "pnpm --dir mobile exec pnpm dlx expo-doctor",
    "preview": "vite preview",
    "dev:mobile": "pnpm --dir mobile exec expo start --port 8082 --max-workers 1",
    "dev:website": "concurrently -k \"pnpm dev:api\" \"pnpm dev:web\"",
    "preview:app": "pnpm --dir mobile run build:web && node scripts/serve-mobile-web.mjs",
    "test:mobile": "tsx --test mobile/src/chat/protocol.test.mjs mobile/src/chat/web-draft.test.mjs mobile/src/requests/contracts.test.mjs mobile/src/manage/formValues.test.mjs mobile/src/manage/providerJob.test.mjs mobile/src/platform/security.test.mjs",
    "data:diagnostics": "tsx scripts/export-diagnostic-db.ts",
    "test:demo-chat": "node scripts/smoke-demo-chat.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@supabase/supabase-js": "^2.57.4",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "multer": "^2.2.0",
    "openai": "^7.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4",
    "stripe": "^18.5.0",
    "twilio": "^6.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "oxlint": "^1.79.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
