PORT=8787
SUPABASE_URL=http://127.0.0.1:56321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=http://127.0.0.1:56321
VITE_SUPABASE_ANON_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=
# Payment mode is fail-closed: disabled (default), drain, or enabled.
# disabled: no payment provider client or money operation.
# drain: reconcile existing persisted obligations only; never originate money movement.
# enabled: requires the owner-approved receipt described below in addition to this value.
PAYMENTS_MODE=disabled
# Enabling payments also requires a verified owner approval receipt bound to mode=enabled,
# environment/project hashes, git SHA, migration head, and capability hashes. Store the
# receipt through the deployment secret/configuration boundary; never commit it here.
PAYMENTS_APPROVAL_RECEIPT=
PAYMENTS_APPROVAL_PUBLIC_KEY=
PAYMENTS_CAPABILITY_HASHES=
PAYMENTS_ENVIRONMENT_HASH=
PAYMENTS_PROJECT_HASH=
GIT_SHA=
MIGRATION_HEAD=
OPERATOR_ALLOWLIST=
RECONCILIATION_JOB_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
INTAKE_SIGNING_SECRET=
# AI usage guard defaults; lower these for a smaller pilot budget.
INTAKE_ACCOUNT_DAILY_CREDITS=40
INTAKE_TOTAL_DAILY_CREDITS=200
INTAKE_GLOBAL_ACTIVE_LIMIT=4
INTAKE_ACCOUNT_ACTIVE_LIMIT=1

# Required integration suite
REQUIRE_SUPABASE_INTEGRATION=1
SUPABASE_TEST_URL=http://127.0.0.1:56321
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=
SUPABASE_TEST_CUSTOMER_TOKEN=
SUPABASE_TEST_PROVIDER_TOKEN=
SUPABASE_TEST_OPERATOR_TOKEN=
INTEGRATION_API_URL=http://127.0.0.1:8787
# Test fixture only; these do not activate real Stripe payments.
INTEGRATION_STRIPE_FIXTURE_URL=
INTEGRATION_STRIPE_FIXTURE_SECRET=
